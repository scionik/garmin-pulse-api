{
  "framework": null,
  "installCommand": "echo 'no dependencies to install'",
  "buildCommand": "echo 'static site - nothing to build'",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/pulse.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
